# Disposable test credentials; test/safety.ts requires an exact match before cleanup.
NODE_ENV="test"
PORT="3002"
LOG_LEVEL="silent"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="app_test"
POSTGRES_PORT="5434"
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/app_test"
REDIS_PORT="6380"
REDIS_URL="redis://localhost:6380"
# Keep the -test suffix: the cleanup guard checks it.
CACHE_NAMESPACE="app-test"
CORS_ORIGINS="http://localhost:3000"
