PORT="3001"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="app"
# Host port for the postgres container; change when a local postgres already uses 5432
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"
REDIS_PORT="6379"
REDIS_URL="redis://localhost:6379"
# Origin allowed to call this api from a browser (the frontend).
FRONTEND_URL="http://localhost:3000"
