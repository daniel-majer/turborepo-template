PORT="3001"
# Pino level override; defaults: development=debug, production=info.
# LOG_LEVEL="debug"

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="app"
# Avoid port 5432 conflicts with a locally installed Postgres.
POSTGRES_PORT="5433"
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/app"
REDIS_PORT="6379"
REDIS_URL="redis://localhost:6379"

# TODO(template): unique cache namespace; clear() deletes only its keys.
CACHE_NAMESPACE="app"

# Browser origins allowed to call this api, comma separated. Empty allows none.
CORS_ORIGINS="http://localhost:3000"
