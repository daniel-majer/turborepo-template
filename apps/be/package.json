{
  "name": "be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run docker:up && bun run db:deploy && nest start --watch",
    "build": "nest build",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:test": "NODE_ENV=test prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "api:spec": "bun run build && node dist/scripts/generate-openapi.js",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "docker:test:down": "docker compose -f docker-compose.test.yml down",
    "start": "node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "check-types": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "bun run docker:test:up && bun run db:migrate:test && NODE_ENV=test vitest run --config ./vitest.config.e2e.ts; status=$?; bun run docker:test:down; exit $status",
    "test:e2e:watch": "NODE_ENV=test vitest --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.3",
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "keyv": "^5.6.0",
    "nestjs-pino": "^5.1.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@golevelup/ts-vitest": "^4.0.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@repo/ts-config": "workspace:*",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.2",
    "pino-pretty": "^13.1.3",
    "source-map-support": "^0.5.21",
    "typescript": "^6",
    "vitest": "^4.1.2"
  }
}
