  "info": {
    "title": "API",
    "description": "Every response is an envelope: `{ data }`, or `{ data: null, error }`.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LivenessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string",
            "example": "up"
          },
          "cache": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string",
            "example": "up"
          }
        },
        "required": [
          "database",
          "cache"
        ]
      },
      "ReadinessDto": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string",
            "description": "\"degraded\" means the cache is unreachable; the api still serves requests",
            "example": "ok"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 255,
            "format": "email",
            "description": "Trimmed and lowercased before it is stored.",
            "example": "ada@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "UsersPageMetaDto": {
        "type": "object",
        "properties": {
          "nextCursor": {
            "type": "integer",
            "nullable": true,
            "example": 20
          },
          "hasNextPage": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "nextCursor",
          "hasNextPage"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 255,
            "format": "email",
            "description": "Trimmed and lowercased before it is stored.",
            "example": "ada@example.com"
          }
        }
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 404
          },
          "message": {
            "type": "string",
            "example": "User 42 not found"
          },
          "details": {
            "description": "One entry per failed constraint, on a validation error.",
            "example": [
              "email must be an email"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-04T10:15:30.000Z"
          },
          "path": {
            "type": "string",
            "description": "The request path that failed.",
            "example": "/api/users/42"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "example": "ad82cc5c-3eb9-4b5c-8d6f-e3f8c99197b3"
          }
        },
        "required": [
          "statusCode",
          "message",
          "timestamp",
          "path",
          "requestId"
        ]
      },
      "ErrorEnvelopeDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "Always null on the error path."
          },
          "error": {
            "$ref": "#/components/schemas/ApiErrorDto"
          }
        },
        "required": [
          "data",
          "error"
        ]
      }
    }
  }
}
