# Required public URL for the frontend application.
# TODO(template): Replace this with the deployed application URL in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Where the browser calls the backend. Must match the backend's FRONTEND_URL
# allowlist in the other direction.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Optional: how the Next server reaches the api when it is not the same host
# the browser uses (a Docker service name, for example).
# API_URL="http://be:3001"
