# Copy to .env beside docker-compose.prod.yml on the server. Never commit real secrets.

# TODO(template): set the lowercase registry path. Private images need registry login.
IMAGE_REPO="ghcr.io/owner/repository"
# Required: copy run-<id>-<attempt> from the successful release summary.
IMAGE_TAG=""

# Generate each password with openssl rand -hex 32; values are inserted into URLs.
# Postgres users/passwords initialize only on an empty volume.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="app"

# Restricted API role; only migrations use the database owner.
APP_DB_USER="app"
APP_DB_PASSWORD=""

REDIS_PASSWORD=""

# Loopback ports for the host's reverse proxy.
API_PORT="3001"
WEB_PORT="3000"

# TODO(template): comma-separated frontend origins; empty allows none.
CORS_ORIGINS="https://example.com"

LOG_LEVEL="info"
# TODO(template): use a unique cache namespace per project.
CACHE_NAMESPACE="app"
