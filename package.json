{
  "name": "turborepo-template",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "setup": "[ -f apps/be/.env ] || cp apps/be/.env.example apps/be/.env; [ -f apps/fe/.env ] || cp apps/fe/.env.example apps/fe/.env",
    "check-types": "turbo run check-types",
    "api:sync": "bun run --cwd apps/be api:spec && bun run --cwd packages/api-client generate",
    "audit": "bun audit",
    "test": "turbo run test && bun run test:release",
    "test:release": "node --test scripts/promote-images.test.mjs",
    "test:e2e": "turbo run test:e2e",
    "verify:images": "bash scripts/verify-images.sh",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "prepare": "husky",
    "boundaries": "turbo boundaries"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.12",
    "typescript": "^6"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "lodash": "4.18.1",
    "mysql2": "3.24.3",
    "valibot": "1.4.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "sharp"
  ]
}
